# DockGrove environment template. Copy to `.env` (gitignored) and fill in only what you need.
# Everything is optional: without values the local stack runs with checkout disabled.
# See SETUP.md for where each value comes from and which ones CI needs as GitHub secrets.
# Never put live (production) keys here. Keep comments on their own lines: Docker Compose
# reads text after an empty `KEY=` as the value.

# --- Local Docker stack (docker compose) ------------------------------------------------
# Website on http://localhost:$WEB_PORT and Worker API on http://localhost:$API_PORT.
WEB_PORT=8080
API_PORT=8787
# Origin the site is served from; defaults to http://localhost:$WEB_PORT.
# PUBLIC_ORIGIN=http://localhost:8080

# --- Commerce Worker, test mode only (forwarded to the api container) -------------------
# The container refuses any mode other than test.
SALES_MODE=test
# Stripe test-mode secret key (sk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the test webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Test-mode price (price_...) and product (prod_...) for the one-time purchase.
STRIPE_PRICE_ID=
STRIPE_PRODUCT_ID=
# Random string, at least 32 characters, used to derive license keys.
LICENSE_KEY_SECRET=
# EC P-256 private key as one-line JSON (JWK). Signs entitlements; never ship it in the app.
ENTITLEMENT_PRIVATE_JWK=
# Key id published to the app alongside the matching public key.
ENTITLEMENT_KEY_ID=test-1
# Object name of the app release in the (local) R2 bucket.
RELEASE_OBJECT=DockGrove-1.zip
# Only needed to exercise license-recovery email: Resend API key and a verified sender.
RESEND_API_KEY=
RECOVERY_FROM=

# --- macOS Commercial build (xcodebuild build settings / GitHub secrets) ----------------
# Public values only. Validate with: swift app/Scripts/ValidateLicenseConfig.swift
# HTTPS origin of the license service, e.g. https://dockgrove.example
DOCKGROVE_LICENSE_SERVER_URL=
# Base64 X9.63 P-256 public key matching ENTITLEMENT_PRIVATE_JWK.
DOCKGROVE_LICENSE_PUBLIC_KEY=
# Same value as ENTITLEMENT_KEY_ID.
DOCKGROVE_LICENSE_KEY_ID=

# --- Optional live checks for the macOS test suite (xcodebuild test) --------------------
# The TEST_RUNNER_ prefix makes xcodebuild forward them to the test process.
# TEST_RUNNER_DOCKGROVE_LIVE_TESTS=1
# TEST_RUNNER_DOCKGROVE_WEATHER_CITY=Boston, Massachusetts

# --- CI/CD only: set as GitHub secrets, not used locally --------------------------------
# CLOUDFLARE_API_TOKEN (in the GitHub `production` environment) deploys dockgrove.com.
