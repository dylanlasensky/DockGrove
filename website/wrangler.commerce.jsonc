{
  // Local/test candidate only. Owner creates bindings and secrets before deployment.
  "name": "wavedock-commerce-test",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SALES_MODE": "test",
    "PUBLIC_ORIGIN": "https://wavedock-commerce-test.example.invalid",
    "STRIPE_PRICE_ID": "",
    "STRIPE_PRODUCT_ID": "",
    "ENTITLEMENT_KEY_ID": "test-1",
    "RELEASE_OBJECT": "WaveDock-1.zip"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "wavedock-commerce-test", "database_id": "OWNER_CONFIG_REQUIRED", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "wavedock-releases-test" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
