# Served by nginxinc/nginx-unprivileged; ${API_UPSTREAM} is substituted at start.
# Mirrors website/public/_headers (security headers + cache policy) and gives the
# Next.js static export clean URLs: /purchase -> purchase.html, /404.html on miss.

map $uri $dockgrove_cache_control {
    default                         "";
    ~^/purchase(\.html)?$           "no-store";
    ~^/recover(\.html)?$            "no-store";
    ~^/product\.json$               "no-cache";
    ~^/_next/static/                "public, max-age=31536000, immutable";
    ~\.(?:css|js|woff2?|ttf|png|jpe?g|gif|webp|avif|svg|ico)$ "public, max-age=86400";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers from website/public/_headers.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Cache-Control $dockgrove_cache_control always;

    error_page 404 /404.html;

    # Commerce backend (Worker API). The upstream owns the response headers.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_read_timeout 60s;
        client_max_body_size 2m;
    }

    location /downloads/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header CF-Connecting-IP $remote_addr;
    }

    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }
}
